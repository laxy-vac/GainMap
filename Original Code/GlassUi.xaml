<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:;assembly=__SELF__"
        Title="GainMap" Width="1020" Height="660" MinWidth="850" MinHeight="580"
        Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="#243044" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True">
  <Window.Resources>
    <Style x:Key="QuietButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#70FFFFFF"/>
      <Setter Property="Foreground" Value="#40566C"/>
      <Setter Property="BorderBrush" Value="#45FFFFFF"/>
      <Setter Property="BorderThickness" Value="0.75"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <local:SmoothBorder x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                </local:SmoothBorder>
                <local:SmoothBorder x:Name="KeyboardFocusRing" Margin="2" Background="Transparent"
                                    BorderBrush="#B08090A4" BorderThickness="1.25" CornerRadius="9"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#A8FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Background" Value="#DF283A4B"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#20FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid>
              <local:SmoothBorder x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
              </local:SmoothBorder>
              <local:SmoothBorder x:Name="KeyboardFocusRing" Margin="2" Background="Transparent"
                                  BorderBrush="#B08090A4" BorderThickness="1.25" CornerRadius="9"
                                  Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#EF34495D"/>
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#45FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QualitySliderStyle" TargetType="{x:Type Slider}">
      <Setter Property="Height" Value="22"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Slider}">
            <Grid Margin="0,2">
              <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                      Background="#50FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="0.5"
                      IsHitTestVisible="False"/>
              <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False"
                                Background="#98849AAF" BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{TemplateBinding Background}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse x:Name="ThumbSurface" Fill="#EEF8FC" Stroke="#738BA1"
                                 StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Fill" Value="#FFFFFF"/>
                            <Setter TargetName="ThumbSurface" Property="Stroke" Value="#536B83"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Fill" Value="#D7E7F0"/>
                          </Trigger>
                          <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.45"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False"
                                Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{TemplateBinding Background}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#60F5F8FC">
    <Grid Margin="0,32,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#58EDF3FA" BorderBrush="#25FFFFFF"
              BorderThickness="0,0,1,0">
        <Grid Margin="24,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
              <Image x:Name="BrandIcon" Width="28" Height="28" Margin="0,0,10,0"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="GainMap" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="输出设置" Foreground="#67798D" Margin="0,40,0,16"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel>
              <TextBlock Text="JPEG Gain Map" FontWeight="SemiBold"/>
              <TextBlock Text="SDR 与 HDR，共用一张图片" Foreground="#67798D" FontSize="11"
                         Margin="0,8,0,28"/>
              <TextBlock Text="保存到" Margin="0,0,0,10"/>
              <local:SmoothBorder Background="#70FFFFFF" BorderBrush="#40FFFFFF"
                                  BorderThickness="0.75" CornerRadius="12" Padding="12,10">
                <TextBlock x:Name="OutputDirectoryLabel" Text="原图所在文件夹"
                           Foreground="#718195" TextWrapping="Wrap" MaxHeight="54"
                           ToolTip="输出目录"/>
              </local:SmoothBorder>
              <Button x:Name="ChooseOutputDirectoryButton" Content="选择输出目录"
                      Style="{StaticResource QuietButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
              <Button x:Name="ResetOutputDirectoryButton" Content="恢复原图目录"
                      Style="{StaticResource QuietButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
              <StackPanel Margin="0,26,0,0">
                <Grid>
                  <TextBlock Text="JPEG 输出质量" Foreground="#67798D" FontSize="11"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="QualityValueLabel" Text="95" Foreground="#40566C"
                             FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="95"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Style="{StaticResource QualitySliderStyle}" Margin="0,7,0,0"
                        AutomationProperties.Name="JPEG 输出质量"/>
                <TextBlock Text="画质更高，文件通常更大" Foreground="#7A8B9D" FontSize="10"
                           Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Grid.Row="2" Text="原始 JXR 会保留" Foreground="#74859A" FontSize="11"/>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="32,24,32,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="图片转换" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="JXR → JPEG Gain Map" Foreground="#76869A" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="QueueCount" Text="尚未添加图片" Foreground="#76869A"
                     VerticalAlignment="Center"/>
          <Button x:Name="AddFilesButton" Grid.Column="1" Content="添加图片"
                  Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
          <Button x:Name="RemoveSelectionButton" Grid.Column="2" Content="移除选中"
                  Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="Collapsed"
                  IsEnabled="False"/>
          <Button x:Name="ClearQueueButton" Grid.Column="3" Content="清空"
                  Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="Collapsed"
                  IsEnabled="False"/>
        </Grid>
        <Grid x:Name="WorkArea" Grid.Row="2" Margin="0,0,0,18">
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="SelectImagesButton" Width="52" Height="52" Margin="0,0,0,22"
                    Cursor="Hand" ToolTip="选择 JXR 图片（支持多选）"
                    AutomationProperties.Name="选择 JXR 图片" FocusVisualStyle="{x:Null}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="ButtonSurface" Background="Transparent">
                    <Ellipse x:Name="Ring" Fill="#50FFFFFF" Stroke="#35FFFFFF" StrokeThickness="0.75"/>
                    <Ellipse x:Name="FocusRing" Margin="2.5" Fill="Transparent" Stroke="#8090A4"
                             StrokeThickness="1" Visibility="Collapsed"/>
                    <Viewbox Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Path x:Name="Arrow" Data="M12,16 L12,4 M7,9 L12,4 L17,9 M5,17 L5,21 L19,21 L19,17"
                              Stroke="#71899D" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      </Canvas>
                    </Viewbox>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Ring" Property="Fill" Value="#8AFFFFFF"/>
                      <Setter TargetName="Arrow" Property="Stroke" Value="#405B73"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <TextBlock Text="把截图放进来" FontSize="22" HorizontalAlignment="Center"/>
            <TextBlock Text="拖入 JXR 文件，开始转换" Foreground="#708198" Margin="0,12"
                       HorizontalAlignment="Center"/>
          </StackPanel>
          <ListView x:Name="FileList" Visibility="Collapsed" Background="Transparent"
                    BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Extended" Focusable="True">
            <ListView.ItemContainerStyle>
              <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                      <local:SmoothBorder x:Name="ItemSurface" Background="#58FFFFFF"
                                          BorderBrush="#32FFFFFF" BorderThickness="0.75"
                                          CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </local:SmoothBorder>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ItemSurface" Property="Background" Value="#A4FFFFFF"/>
                          <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#608AA9C3"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#8090A4"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding FilePath}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="24" Height="24" CornerRadius="7" Background="#40FFFFFF"
                          VerticalAlignment="Center">
                    <TextBlock Text="JXR" FontSize="8" Foreground="#67798D"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                               FontWeight="Medium"/>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="#8090A4" FontSize="10"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#64788D"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
        <Grid Grid.Row="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ProgressBar x:Name="ConversionProgress" Grid.Row="0" Height="3" Minimum="0" Maximum="1"
                       Value="0" Foreground="#536B83" Background="#30FFFFFF" BorderThickness="0"/>
          <local:SmoothBorder Grid.Row="1" CornerRadius="16" Background="#8CFFFFFF"
                              BorderBrush="#45FFFFFF" BorderThickness="0.75" Padding="20,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="135"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="转换进度" FontSize="11" Foreground="#566E86"/>
                <TextBlock x:Name="ProgressHint" Text="添加图片，即可开始转换" FontSize="12"
                           Foreground="#7A8B9D" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="FailureDetailsButton" Grid.Column="1" Content="查看失败详情"
                      Style="{StaticResource QuietButton}" Margin="8,0,12,0" Visibility="Collapsed"/>
              <Button x:Name="StartConvertButton" Grid.Column="2" Content="开始转换  ↑"
                      Style="{StaticResource PrimaryButton}" Height="42" IsEnabled="False"/>
            </Grid>
          </local:SmoothBorder>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
